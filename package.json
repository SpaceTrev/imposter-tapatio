{
  "name": "imposter-tapatio",
  "private": true,
  "version": "1.0.0",
  "description": "Imposter Radar Tapatío - A fun party game for iOS, Android and Web",
  "scripts": {
    "dev": "pnpm --filter @imposter/web dev",
    "dev:mobile": "pnpm --filter @imposter/mobile start",
    "build": "pnpm --filter @imposter/web build",
    "build:mobile:ios": "pnpm --filter @imposter/mobile build:ios",
    "build:mobile:android": "pnpm --filter @imposter/mobile build:android",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r exec rm -rf node_modules && rm -rf node_modules"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@9.0.0"
}
